/* Miuu's Cinematic Birthday Surprise - Premium Luxury Design System */

@import url('https://fonts.googleapis.com/css2?family=Great+Vibes&family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');

:root {
  --rose-gold: #e0a996;
  --soft-pink: #ffb7b2;
  --lavender: #b5a6c9;
  --gold: #d4af37;
  --light-gold: #f3e5ab;
  --deep-purple: #1a0b2e;
  --night-blue: #0b071e;
  --glow-color: rgba(224, 169, 150, 0.4);
  --glass-bg: rgba(26, 11, 46, 0.55);
  --glass-border: rgba(224, 169, 150, 0.25);
  --font-serif: 'Playfair Display', serif;
  --font-cursive: 'Great Vibes', cursive;
  --font-sans: 'Inter', sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  width: 100%;
  overflow-x: hidden;
  background-color: var(--night-blue);
  color: #fff;
  font-family: var(--font-sans);
  scroll-behavior: auto !important;
  cursor: none; /* Hide default cursor on background */
}

/* Allow native pointer cursor for interactive items so they are easy to click */
a, button, input, select, textarea, [role="button"], 
.close-modal-btn, .control-btn, .password-btn, .flower-bud, 
.floating-lantern, .map-pin, .constellation-star, .envelope-wrapper, 
.polaroid-card, .lever-handle, .memory-bubble, .safe-dial, .story-btn,
.gift-box, .castle-gates, .moon-portal {
  cursor: pointer !important;
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 8px;
}
::-webkit-scrollbar-track {
  background: var(--night-blue);
}
::-webkit-scrollbar-thumb {
  background: var(--rose-gold);
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--gold);
}

/* Custom Cursor & Trails */
.custom-cursor {
  width: 8px;
  height: 8px;
  background: var(--gold);
  border-radius: 50%;
  position: fixed;
  pointer-events: none;
  z-index: 999999 !important; /* Always on top of modals and elements */
  transform: translate(-50%, -50%);
  transition: transform 0.05s ease-out;
}

.custom-cursor-glow {
  width: 36px;
  height: 36px;
  border: 1px solid var(--rose-gold);
  background: rgba(224, 169, 150, 0.05);
  border-radius: 50%;
  position: fixed;
  pointer-events: none;
  z-index: 999998 !important; /* Always on top of modals and elements */
  transform: translate(-50%, -50%);
  transition: transform 0.15s ease-out, width 0.3s, height 0.3s;
}

.cursor-hover .custom-cursor-glow {
  width: 56px;
  height: 56px;
  border-color: var(--gold);
  background: rgba(212, 175, 55, 0.15);
}

/* Stars & Aurora Canvas Backdrop */
#bg-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  pointer-events: none;
}

.aurora-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at 30% 20%, rgba(181, 166, 201, 0.08) 0%, transparent 40%),
              radial-gradient(circle at 70% 80%, rgba(224, 169, 150, 0.08) 0%, transparent 45%);
  z-index: 1;
  pointer-events: none;
}

/* Glassmorphism card utility */
.glass-panel {
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
}

.luxury-text-gradient {
  background: linear-gradient(135deg, var(--light-gold) 0%, var(--rose-gold) 50%, var(--gold) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 0 10px rgba(212, 175, 55, 0.15);
}

/* --- Password Gate Screen --- */
.password-screen {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(to bottom, #05030f, #0b071e);
  transition: opacity 1.5s ease-in-out, transform 1.5s ease-in-out;
}

.password-screen.fade-out {
  opacity: 0;
  transform: scale(1.1);
  pointer-events: none;
}

.moon-portal {
  width: 120px;
  height: 120px;
  background: radial-gradient(circle at 35% 35%, #fff 10%, var(--light-gold) 50%, var(--rose-gold) 100%);
  border-radius: 50%;
  box-shadow: 0 0 40px 10px rgba(255, 255, 255, 0.6), 0 0 80px 20px rgba(224, 169, 150, 0.3);
  margin-bottom: 25px;
  animation: floatMoon 6s ease-in-out infinite;
}

.portal-text {
  font-family: var(--font-serif);
  font-size: 1.6rem;
  color: var(--light-gold);
  letter-spacing: 2px;
  margin-bottom: 10px;
  text-shadow: 0 0 8px var(--rose-gold);
}

.portal-subtext {
  font-family: var(--font-sans);
  font-size: 0.95rem;
  color: var(--lavender);
  margin-bottom: 35px;
  font-weight: 300;
}

.password-card {
  padding: 30px 40px;
  max-width: 400px;
  width: 90%;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.password-input {
  width: 100%;
  padding: 12px 20px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(224, 169, 150, 0.4);
  border-radius: 30px;
  color: #fff;
  font-size: 1rem;
  text-align: center;
  outline: none;
  font-family: var(--font-sans);
  letter-spacing: 2px;
  transition: border-color 0.3s, box-shadow 0.3s;
  margin-bottom: 15px;
}

.password-input:focus {
  border-color: var(--gold);
  box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
}

.password-btn {
  background: linear-gradient(135deg, var(--rose-gold) 0%, var(--gold) 100%);
  border: none;
  color: var(--deep-purple);
  padding: 12px 30px;
  border-radius: 30px;
  font-weight: bold;
  letter-spacing: 1px;
  box-shadow: 0 4px 15px rgba(224, 169, 150, 0.4);
  transition: transform 0.2s, box-shadow 0.2s;
  margin-bottom: 10px;
}

.password-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(212, 175, 55, 0.6);
}

.hint-trigger {
  font-size: 0.8rem;
  color: var(--lavender);
  text-decoration: underline;
  margin-top: 10px;
  display: inline-block;
  opacity: 0.8;
}

/* Cute Wrong Popup */
.wrong-popup {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.8);
  background: var(--glass-bg);
  border: 1px solid rgba(255, 0, 0, 0.3);
  padding: 20px;
  border-radius: 12px;
  box-shadow: 0 0 20px rgba(255, 0, 0, 0.2);
  width: 85%;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  z-index: 100;
}

.wrong-popup.active {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, -50%) scale(1);
}

.wrong-popup p {
  color: var(--soft-pink);
  font-size: 0.95rem;
  margin-bottom: 12px;
}

.close-popup-btn {
  background: var(--rose-gold);
  border: none;
  padding: 5px 15px;
  border-radius: 15px;
  color: var(--deep-purple);
  font-size: 0.8rem;
  font-weight: bold;
}

/* --- Storybook Intro --- */
.storybook-screen {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 900;
  background: linear-gradient(135deg, #100620 0%, #1c0f32 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.storybook-container {
  width: 650px;
  height: 450px;
  perspective: 1500px;
  position: relative;
}

.storybook-page {
  width: 100%;
  height: 100%;
  position: absolute;
  background: #fbf5e6; /* Antique paper look */
  border-radius: 4px 16px 16px 4px;
  border: 1px solid #d4c5a0;
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 50px;
  color: #4a3b2c;
  transform-style: preserve-3d;
  transform-origin: left center;
  transition: transform 1.5s cubic-bezier(0.645, 0.045, 0.355, 1);
  backface-visibility: hidden;
}

.storybook-page.page-flipped {
  transform: rotateY(-180deg);
}

.storybook-content {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.storybook-content h2 {
  font-family: var(--font-cursive);
  font-size: 3.5rem;
  margin-bottom: 20px;
  color: #6a4a35;
}

.storybook-content p {
  font-family: var(--font-serif);
  font-size: 1.3rem;
  line-height: 1.8;
  color: #5c4839;
  white-space: pre-line;
}

.story-btn {
  margin-top: 30px;
  background: #6a4a35;
  color: #fff;
  border: none;
  padding: 10px 25px;
  font-family: var(--font-sans);
  border-radius: 20px;
  box-shadow: 0 4px 10px rgba(106, 74, 53, 0.3);
}

/* Happy Birthday Dramatic Intro Reveal */
.grand-reveal-screen {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 800;
  background: radial-gradient(circle, var(--deep-purple) 0%, var(--night-blue) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 1s, visibility 1s;
}

.grand-reveal-screen.active {
  opacity: 1;
  visibility: visible;
}

.reveal-title {
  font-family: var(--font-serif);
  font-size: 4rem;
  font-weight: bold;
  letter-spacing: 4px;
  animation: shineGold 3s infinite alternate;
  margin-bottom: 20px;
  text-align: center;
}

.reveal-subtitle {
  font-family: var(--font-cursive);
  font-size: 3.2rem;
  color: var(--soft-pink);
  text-shadow: 0 0 15px var(--rose-gold);
  margin-bottom: 40px;
}

.reveal-message {
  max-width: 500px;
  text-align: center;
  font-size: 1.1rem;
  color: var(--lavender);
  line-height: 1.6;
  font-weight: 300;
  margin-bottom: 30px;
}

/* --- Floating Music Player --- */
.floating-player {
  position: fixed;
  bottom: 25px;
  right: 25px;
  z-index: 900;
  width: 280px;
  padding: 15px;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 20px;
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
}

.player-header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.player-header span {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--lavender);
}

.player-main {
  display: flex;
  align-items: center;
  width: 100%;
}

.vinyl-disc {
  width: 55px;
  height: 55px;
  background: radial-gradient(circle, #222 25%, #111 60%, #444 80%, #111 100%);
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.5);
}

.vinyl-disc::before {
  content: '';
  width: 15px;
  height: 15px;
  background: var(--gold);
  border-radius: 50%;
}

.vinyl-disc.spinning {
  animation: rotateVinyl 4s linear infinite;
}

.player-info {
  flex: 1;
}

.song-title {
  font-family: var(--font-serif);
  font-size: 0.9rem;
  color: var(--light-gold);
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 160px;
}

.song-artist {
  font-size: 0.75rem;
  color: var(--lavender);
}

.player-controls {
  display: flex;
  align-items: center;
  margin-top: 12px;
  width: 100%;
  justify-content: space-between;
}

.control-btn {
  background: none;
  border: none;
  color: var(--light-gold);
  font-size: 1.1rem;
  transition: transform 0.2s, color 0.2s;
}

.control-btn:hover {
  color: var(--gold);
  transform: scale(1.15);
}

.progress-container {
  flex: 1;
  margin: 0 10px;
  height: 4px;
  background: rgba(255,255,255,0.1);
  border-radius: 2px;
  position: relative;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: var(--rose-gold);
  width: 0%;
  transition: width 0.1s linear;
}

.volume-container {
  display: flex;
  align-items: center;
}

.volume-slider {
  width: 50px;
  height: 4px;
  background: rgba(255, 255, 255, 0.15);
  outline: none;
  border: none;
  -webkit-appearance: none;
  border-radius: 2px;
  margin-left: 5px;
}

.volume-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--gold);
}

/* Visualizer Bars */
.visualizer-container {
  display: flex;
  height: 15px;
  align-items: flex-end;
  margin-left: auto;
}

.visualizer-bar {
  width: 2px;
  height: 2px;
  background: var(--rose-gold);
  margin: 0 1px;
  border-radius: 1px;
  transition: height 0.1s ease;
}

.visualizer-bar.playing {
  animation: visualize 0.8s ease infinite alternate;
}

/* --- Main World Layout --- */
.main-world {
  opacity: 1 !important;
  transition: none !important;
  position: relative;
  z-index: 10;
}

.main-world.active {
  opacity: 1 !important;
}

/* Sections Wrapper */
.world-section {
  min-height: 100vh;
  padding: 80px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-bottom: 1px solid rgba(224, 169, 150, 0.1);
  overflow: hidden;
}

.section-title {
  font-family: var(--font-serif);
  font-size: 2.8rem;
  letter-spacing: 2px;
  margin-bottom: 15px;
  text-align: center;
}

.section-subtitle {
  font-family: var(--font-cursive);
  font-size: 2.2rem;
  color: var(--soft-pink);
  margin-bottom: 50px;
  text-align: center;
}

/* --- Location 1: Moon Garden --- */
.garden-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  max-width: 1000px;
  gap: 15px;
}

.flower-bud {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: radial-gradient(circle, var(--glass-bg), var(--deep-purple));
  border: 1px solid var(--glass-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  box-shadow: 0 0 10px rgba(181, 166, 201, 0.15);
  transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.flower-bud:hover {
  transform: scale(1.15) rotate(10deg);
  border-color: var(--gold);
  box-shadow: 0 0 15px rgba(212, 175, 55, 0.4);
}

.flower-bud.bloomed {
  background: radial-gradient(circle, #fff0f5 10%, var(--soft-pink) 50%, var(--rose-gold) 100%);
  border-color: var(--rose-gold);
  box-shadow: 0 0 20px var(--glow-color);
  animation: bloomPulse 2s infinite alternate;
}

/* --- Location 2: Memory Lake --- */
.lake-container {
  width: 100%;
  max-width: 900px;
  height: 400px;
  background: linear-gradient(to bottom, rgba(11, 7, 30, 0.3), rgba(26, 11, 46, 0.7));
  border-radius: 24px;
  border: 1px solid var(--glass-border);
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 0 50px rgba(0,0,0,0.8);
}

.lake-ripple {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.floating-lantern {
  position: absolute;
  width: 40px;
  height: 40px;
  background: radial-gradient(circle, var(--light-gold) 20%, var(--gold) 80%);
  border-radius: 50% 50% 0 0;
  box-shadow: 0 -5px 15px rgba(212, 175, 55, 0.8), 0 5px 10px rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  animation: drift 8s ease-in-out infinite alternate;
}

.floating-lantern::after {
  content: '';
  position: absolute;
  bottom: -6px;
  left: 5px;
  width: 30px;
  height: 6px;
  background: rgba(212, 175, 55, 0.3);
  filter: blur(2px);
  border-radius: 50%;
}

/* --- Location 3: Secret Letter Room --- */
.letter-room-container {
  display: flex;
  justify-content: center;
  gap: 30px;
  flex-wrap: wrap;
  width: 100%;
  max-width: 1000px;
}

.envelope-wrapper {
  perspective: 1000px;
}

.envelope {
  position: relative;
  width: 280px;
  height: 180px;
  background: radial-gradient(circle, #f3e5ab, #d4c5a0);
  border-radius: 10px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.4);
  transition: transform 0.5s;
  overflow: visible; /* flap needs to rotate outside bounds */
}

.envelope-flap {
  position: absolute;
  top: 0;
  left: 0;
  width: 0;
  height: 0;
  border-left: 140px solid transparent;
  border-right: 140px solid transparent;
  border-top: 95px solid #d4c5a0;
  transform-origin: top center;
  transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  z-index: 10;
  filter: drop-shadow(0 4px 5px rgba(0,0,0,0.2));
}

.envelope.flap-open .envelope-flap {
  transform: rotateX(180deg);
  border-top-color: #e6d9b8;
  z-index: 1;
}

.envelope-content-preview {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 10px;
  padding: 25px 20px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center; /* Center preview vertically */
  align-items: center; /* Center preview horizontally */
  text-align: center;
  color: #4a3b2c;
  z-index: 2;
}

.envelope-content-preview h4 {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  color: #6a4a35;
  margin-bottom: 4px;
}

.envelope-content-preview small {
  color: #8c765c;
  font-size: 0.85rem;
  margin-bottom: 8px;
}

.envelope-content-preview .preview-text {
  font-size: 0.85rem;
  line-height: 1.45;
  color: #5c4839;
  display: -webkit-box;
  -webkit-line-clamp: 3; /* Limit preview to exactly 3 lines */
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  margin: 0;
}

.secret-letter-modal-sheet {
  width: 480px;
  max-width: 90%;
  height: 500px;
  background: #fffdf5;
  border-radius: 12px;
  box-shadow: inset 0 0 25px rgba(0,0,0,0.06), 0 20px 45px rgba(0,0,0,0.45);
  padding: 35px 30px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  animation: fadeInGlow 0.5s ease-out forwards;
  z-index: 15;
}

/* --- Location 4: Gallery of Smiles --- */
.gallery-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 25px;
  max-width: 1100px;
}

.polaroid-card {
  background: #fff;
  padding: 15px 15px 35px 15px;
  border-radius: 4px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.3);
  width: 240px;
  transform: rotate(var(--rot, -3deg));
  transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s;
}

.polaroid-card:hover {
  transform: rotate(0deg) scale(1.08) translateY(-10px);
  box-shadow: 0 15px 35px rgba(224, 169, 150, 0.5);
  z-index: 50;
}

.polaroid-img-wrapper {
  width: 100%;
  height: 190px;
  background: #e8e8e8;
  overflow: hidden;
  border-radius: 2px;
  position: relative;
}

.polaroid-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s;
}

.polaroid-card:hover .polaroid-img {
  transform: scale(1.08);
}

.polaroid-caption {
  font-family: var(--font-cursive);
  font-size: 1.5rem;
  color: #333;
  margin-top: 15px;
  text-align: center;
}

/* --- Location 5: 100 Reasons Why Miuu is Amazing --- */
.reasons-container {
  display: flex;
  overflow-x: auto;
  padding: 20px 40px;
  width: 100%;
  max-width: 1200px;
  gap: 20px;
  scrollbar-width: thin;
}

.reason-card {
  flex: 0 0 260px;
  height: 350px;
  padding: 30px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
  transition: transform 0.3s, border-color 0.3s;
}

.reason-card:hover {
  transform: translateY(-10px);
  border-color: var(--gold);
}

.reason-card i {
  font-size: 2.2rem;
  color: var(--rose-gold);
  margin-bottom: 20px;
  animation: floatHeart 2.5s ease-in-out infinite alternate;
}

/* --- Location 6: Wish Constellation --- */
.constellation-wrapper {
  width: 100%;
  max-width: 900px;
  height: 550px;
  position: relative;
  border-radius: 24px;
  border: 1px solid var(--glass-border);
  background: radial-gradient(circle, rgba(20, 10, 35, 0.6) 0%, rgba(5, 2, 12, 0.95) 100%);
  overflow: hidden;
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6), inset 0 0 50px rgba(212, 175, 55, 0.05);
}

.constellation-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* Floating Blessings overlay styles */
.blessing-float {
  position: absolute;
  padding: 10px 16px;
  background: rgba(26, 12, 47, 0.85);
  border: 1px solid var(--rose-gold);
  border-radius: 12px;
  color: #fff;
  font-family: var(--font-sans);
  font-size: 0.9rem;
  box-shadow: 0 0 15px rgba(224, 169, 150, 0.3);
  pointer-events: none;
  z-index: 10;
  transform: translate(-50%, -100%);
  animation: floatUpAndFade 3s ease-out forwards;
  max-width: 250px;
  text-align: center;
}

@keyframes floatUpAndFade {
  0% {
    opacity: 0;
    transform: translate(-50%, -80%) scale(0.9);
  }
  15% {
    opacity: 1;
    transform: translate(-50%, -100%) scale(1);
  }
  75% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -140%) scale(0.9);
  }
}

/* UI Overlays */
.constellation-ui {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.ui-fade-in {
  opacity: 0;
  animation: uiFadeIn 1s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  pointer-events: auto;
}

@keyframes uiFadeIn {
  to {
    opacity: 1;
  }
}

.crown-title {
  font-family: var(--font-serif);
  font-size: 2.2rem;
  color: var(--gold);
  text-shadow: 0 0 20px rgba(212, 175, 55, 0.6);
  margin-bottom: 10px;
  text-align: center;
}

.crown-subtitle {
  font-family: var(--font-serif);
  font-size: 1.6rem;
  color: #fff;
  text-shadow: 0 0 15px rgba(255, 255, 255, 0.4);
  margin-bottom: 8px;
  text-align: center;
}

.crown-desc {
  font-family: var(--font-sans);
  font-size: 1rem;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.6;
  text-align: center;
  max-width: 500px;
  margin-bottom: 20px;
}

.moon-blessing-text {
  font-family: var(--font-serif);
  font-size: 1.2rem;
  color: var(--rose-gold);
  text-shadow: 0 0 10px rgba(224, 169, 150, 0.4);
  text-align: center;
  margin-top: 20px;
}

/* Secret Glass Card */
.secret-wish-card {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(224, 169, 150, 0.25);
  border-radius: 20px;
  padding: 30px;
  max-width: 450px;
  width: 90%;
  text-align: center;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(255, 255, 255, 0.05);
  transform: scale(0.95);
  opacity: 0;
  animation: cardReveal 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  pointer-events: auto;
  z-index: 12;
}

@keyframes cardReveal {
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.secret-card-title {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  color: var(--gold);
  text-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
  margin-bottom: 15px;
}

.secret-card-text {
  font-family: var(--font-sans);
  font-size: 1.05rem;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.95);
  font-style: italic;
  margin-bottom: 15px;
}

.secret-card-heart {
  font-size: 1.5rem;
  color: var(--rose-gold);
  text-shadow: 0 0 8px var(--rose-gold);
}

.final-brightest-star {
  position: absolute;
  bottom: 40px;
  font-family: var(--font-serif);
  font-size: 1.4rem;
  color: var(--gold);
  text-shadow: 0 0 15px rgba(212, 175, 55, 0.5);
  text-align: center;
  margin: 0;
}

/* --- Location 7: Memory Book --- */
.memory-book-container {
  width: 100%;
  max-width: 750px;
  height: 480px;
  perspective: 1200px;
  display: flex;
  justify-content: center;
}

.book-shelf {
  width: 100%;
  height: 100%;
  display: flex;
  background: var(--glass-bg);
  border-radius: 12px;
  border: 1px solid var(--glass-border);
  box-shadow: 0 15px 30px rgba(0,0,0,0.5);
  overflow: hidden;
}

.book-half {
  flex: 1;
  padding: 30px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  overflow-y: auto;
}

.book-half.left-half {
  border-right: 1px solid rgba(224, 169, 150, 0.15);
  background: linear-gradient(to right, rgba(0,0,0,0.1), transparent);
}

/* --- Location 8: Treasure Hunt --- */
.treasure-hunt-card {
  max-width: 600px;
  width: 90%;
  padding: 35px;
  text-align: center;
}

.clue-box {
  margin: 25px 0;
  font-style: italic;
  color: var(--light-gold);
  font-family: var(--font-serif);
  font-size: 1.2rem;
}

.hunt-input {
  width: 100%;
  max-width: 300px;
  padding: 10px 15px;
  text-align: center;
  border-radius: 20px;
  border: 1px solid var(--glass-border);
  background: rgba(255,255,255,0.05);
  color: #fff;
  margin-bottom: 20px;
}

/* --- Location 10: Memory Map --- */
.map-container {
  width: 100%;
  max-width: 950px;
  height: 450px;
  background: radial-gradient(circle, rgba(20, 10, 40, 0.4), rgba(5, 2, 12, 0.9));
  border-radius: 24px;
  border: 1px solid var(--glass-border);
  position: relative;
  overflow: hidden;
}

.map-pin {
  position: absolute;
  width: 16px;
  height: 16px;
  background: var(--rose-gold);
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg) translate(-50%, -50%);
  animation: pulsePin 2s infinite alternate;
  box-shadow: 0 0 10px rgba(224, 169, 150, 0.8);
}

.map-pin::after {
  content: '';
  width: 6px;
  height: 6px;
  background: #fff;
  position: absolute;
  top: 5px;
  left: 5px;
  border-radius: 50%;
}

/* --- Location 11: Countdown --- */
.countdown-box {
  display: flex;
  gap: 20px;
  margin-top: 30px;
}

.countdown-item {
  width: 110px;
  height: 110px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.3);
}

.countdown-val {
  font-family: var(--font-serif);
  font-size: 2.5rem;
  font-weight: bold;
  color: var(--light-gold);
}

.countdown-unit {
  font-size: 0.8rem;
  color: var(--lavender);
  text-transform: uppercase;
}

/* --- Location 12: Secret Password Room --- */
.safe-dial-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.safe-dial {
  width: 150px;
  height: 150px;
  border-radius: 50%;
  border: 6px solid var(--gold);
  background: radial-gradient(circle, #2a1b4e 30%, #100628 80%);
  box-shadow: 0 10px 25px rgba(0,0,0,0.5);
  position: relative;
  transition: transform 0.5s;
}

/* --- Location 13: Memory Bubbles --- */
.bubble-canvas {
  width: 100%;
  max-width: 900px;
  height: 400px;
  position: relative;
  background: rgba(26, 11, 46, 0.2);
  border-radius: 20px;
  border: 1px solid var(--glass-border);
  overflow: hidden;
}

.memory-bubble {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.2) 10%, rgba(181, 166, 201, 0.1) 40%, rgba(224, 169, 150, 0.2) 100%);
  box-shadow: inset 0 0 15px rgba(255,255,255,0.3), 0 5px 15px rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  transition: transform 0.1s;
}

/* --- Location 14: Video Player --- */
.video-frame-glow {
  max-width: 750px;
  width: 90%;
  border-radius: 24px;
  padding: 10px;
  background: linear-gradient(135deg, var(--rose-gold) 0%, var(--gold) 100%);
  box-shadow: 0 0 35px rgba(224, 169, 150, 0.4);
}

.cinematic-player {
  width: 100%;
  border-radius: 16px;
  display: block;
}

/* --- Location 17: Compliment Machine --- */
.machine-box {
  width: 320px;
  padding: 30px;
  text-align: center;
}

.lever-handle {
  width: 40px;
  height: 120px;
  background: #333;
  border-radius: 8px;
  margin: 20px auto;
  position: relative;
  transform-origin: bottom center;
  transition: transform 0.2s;
}

.lever-ball {
  position: absolute;
  top: -15px;
  left: 5px;
  width: 30px;
  height: 30px;
  background: radial-gradient(circle, #ff007f, #b30059);
  border-radius: 50%;
}

/* --- Location 18: Dream Tree --- */
.dream-tree-wrapper {
  width: 100%;
  max-width: 900px;
  height: 480px;
  position: relative;
  border-radius: 24px;
  border: 1px solid var(--glass-border);
  overflow: hidden;
  background: radial-gradient(circle, rgba(20, 10, 45, 0.4), rgba(5, 2, 12, 0.95));
}

/* --- Location 20: The Final Castle & Grand Finale --- */
.castle-entrance {
  text-align: center;
  perspective: 1200px;
}

.castle-gates {
  width: 300px;
  height: 250px;
  display: flex;
  margin: 30px auto;
  box-shadow: 0 15px 30px rgba(0,0,0,0.5);
  border-radius: 8px;
  overflow: hidden;
}

.gate-door {
  flex: 1;
  height: 100%;
  background: radial-gradient(circle, #5c4a35, #352516);
  border: 2px solid var(--gold);
  transform-origin: var(--origin);
  transition: transform 3.5s cubic-bezier(0.25, 1, 0.5, 1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.gate-door.open {
  transform: rotateY(var(--rotY));
}

.gate-door i {
  font-size: 2rem;
  color: var(--gold);
}

.finale-box {
  max-width: 800px;
  margin: 50px auto;
  text-align: center;
  padding: 40px;
}

.grand-ending-moon-placeholder {
  width: 180px;
  height: 180px;
  border-radius: 50%;
  border: 4px solid var(--gold);
  background: radial-gradient(circle, #fff 20%, var(--light-gold) 60%, var(--rose-gold) 100%);
  margin: 30px auto;
  box-shadow: 0 0 35px var(--gold);
  overflow: hidden;
  position: relative;
}

.grand-ending-moon-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Modal and Popups */
.custom-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(10, 5, 20, 0.85);
  backdrop-filter: blur(8px);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  padding: 40px;
  max-width: 500px;
  width: 90%;
  text-align: center;
}

.close-modal-btn {
  background: linear-gradient(135deg, var(--rose-gold) 0%, var(--gold) 100%);
  color: var(--deep-purple);
  border: none;
  padding: 10px 25px;
  border-radius: 20px;
  margin-top: 25px;
  font-weight: bold;
}

/* --- KEYFRAMES --- */
@keyframes floatMoon {
  0% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-10px) rotate(2deg); }
  100% { transform: translateY(0px) rotate(0deg); }
}

@keyframes rotateVinyl {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes visualize {
  0% { height: 2px; }
  100% { height: 15px; }
}

@keyframes floatHeart {
  0% { transform: translateY(0px) scale(1); }
  100% { transform: translateY(-8px) scale(1.1); }
}

@keyframes bloomPulse {
  0% { box-shadow: 0 0 10px rgba(255, 183, 178, 0.4); }
  100% { box-shadow: 0 0 25px rgba(255, 183, 178, 0.8); }
}

@keyframes drift {
  0% { transform: translate(0, 0) rotate(-2deg); }
  50% { transform: translate(15px, -5px) rotate(2deg); }
  100% { transform: translate(-10px, 5px) rotate(-1deg); }
}

@keyframes pulsePin {
  0% { transform: rotate(-45deg) scale(0.9); }
  100% { transform: rotate(-45deg) scale(1.1); }
}

@keyframes shineGold {
  0% { text-shadow: 0 0 10px rgba(212, 175, 55, 0.5); }
  100% { text-shadow: 0 0 25px rgba(212, 175, 55, 0.9), 0 0 50px rgba(224, 169, 150, 0.5); }
}

/* Mobile Responsiveness */
@media (max-width: 768px) {
  .section-title { font-size: 2.2rem; }
  .section-subtitle { font-size: 1.8rem; }
  .storybook-container { width: 95%; height: 400px; }
  .storybook-page { padding: 25px; }
  .storybook-content h2 { font-size: 2.5rem; }
  .storybook-content p { font-size: 1.05rem; }
  .countdown-box { gap: 10px; }
  .countdown-item { width: 75px; height: 75px; }
  .countdown-val { font-size: 1.8rem; }
  .floating-player { width: 90%; right: 5%; bottom: 15px; }
  .book-shelf { flex-direction: column; }
}

/* ==========================================================================
   ✨ SPECIAL PHOTO INTEGRATION & PASSWORD SCREEN ENHANCEMENTS ✨
   ========================================================================== */

/* --- Enhanced Password Gate --- */

/* Aurora Background */
.gate-aurora {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at 20% 30%, rgba(224, 169, 150, 0.12) 0%, transparent 50%),
              radial-gradient(circle at 80% 70%, rgba(181, 166, 201, 0.15) 0%, transparent 60%),
              radial-gradient(circle at 50% 10%, rgba(212, 175, 55, 0.08) 0%, transparent 40%);
  filter: blur(40px);
  animation: auroraPulse 10s ease-in-out infinite alternate;
  pointer-events: none;
  z-index: 1;
}

@keyframes auroraPulse {
  0% { transform: scale(1) rotate(0deg); opacity: 0.8; }
  100% { transform: scale(1.1) rotate(3deg); opacity: 1; }
}

/* Moving Clouds */
.gate-cloud {
  position: absolute;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.06) 0%, transparent 70%);
  border-radius: 50%;
  filter: blur(20px);
  pointer-events: none;
  z-index: 2;
}
.gate-cloud.c1 { width: 400px; height: 150px; top: 15%; left: -200px; animation: driftCloud 45s linear infinite; }
.gate-cloud.c2 { width: 500px; height: 180px; bottom: 20%; right: -250px; animation: driftCloudRev 60s linear infinite; }

@keyframes driftCloud {
  0% { left: -400px; }
  100% { left: 100%; }
}
@keyframes driftCloudRev {
  0% { right: -500px; }
  100% { right: 100%; }
}

/* Shooting Stars */
.gate-shooting-star {
  position: absolute;
  width: 120px;
  height: 2px;
  background: linear-gradient(90deg, #fff, transparent);
  transform: rotate(-35deg);
  opacity: 0;
  pointer-events: none;
  z-index: 2;
  animation: shootStar 8s ease-in-out infinite;
}
.gate-shooting-star.s1 { top: 10%; left: 20%; animation-delay: 1s; }
.gate-shooting-star.s2 { top: 25%; left: 60%; animation-delay: 4s; }
.gate-shooting-star.s3 { top: 5%; left: 80%; animation-delay: 6s; }

@keyframes shootStar {
  0% { transform: translateX(0) translateY(0) rotate(-35deg) scale(0); opacity: 0; }
  5% { opacity: 0.8; transform: translateX(0) translateY(0) rotate(-35deg) scale(1); }
  15% { transform: translateX(250px) translateY(175px) rotate(-35deg) scale(0); opacity: 0; }
  100% { transform: translateX(250px) translateY(175px) rotate(-35deg) scale(0); opacity: 0; }
}

/* Sparkles around Title */
.sparkle-container {
  pointer-events: none;
  z-index: 3;
  width: 100%;
  text-align: center;
  margin-bottom: 12px;
}
.sparkle-star {
  position: absolute;
  color: var(--light-gold);
  font-size: 0.8rem;
  animation: pulseSparkle 3s ease-in-out infinite alternate;
}
@keyframes pulseSparkle {
  0% { transform: scale(0.6) rotate(0deg); opacity: 0.3; filter: drop-shadow(0 0 1px var(--gold)); }
  100% { transform: scale(1.1) rotate(90deg); opacity: 0.9; filter: drop-shadow(0 0 5px var(--gold)); }
}

/* Floating Butterflies */
.gate-butterfly {
  position: absolute;
  width: 18px;
  height: 14px;
  pointer-events: none;
  z-index: 5;
  animation: flyAround 18s ease-in-out infinite alternate;
}
.gate-butterfly .wing {
  position: absolute;
  width: 9px;
  height: 14px;
  background: linear-gradient(to bottom, var(--soft-pink), var(--rose-gold));
  border-radius: 9px 9px 4px 4px;
  transform-origin: right center;
  animation: flapWing 0.12s linear infinite alternate;
  box-shadow: 0 0 6px var(--rose-gold);
}
.gate-butterfly .wing.right {
  left: 9px;
  transform-origin: left center;
  animation-name: flapWingRight;
}

@keyframes flapWing {
  0% { transform: rotateY(0deg); }
  100% { transform: rotateY(70deg); }
}
@keyframes flapWingRight {
  0% { transform: rotateY(0deg); }
  100% { transform: rotateY(-70deg); }
}
@keyframes flyAround {
  0% { transform: translate(0, 0) rotate(0deg) scale(0.8); }
  25% { transform: translate(15vw, -5vh) rotate(20deg) scale(0.9); }
  50% { transform: translate(35vw, 10vh) rotate(-10deg) scale(0.8); }
  75% { transform: translate(20vw, 30vh) rotate(-35deg) scale(1); }
  100% { transform: translate(45vw, 5vh) rotate(15deg) scale(0.85); }
}

/* Fireflies */
.gate-firefly {
  position: absolute;
  width: 5px;
  height: 5px;
  background: var(--light-gold);
  border-radius: 50%;
  box-shadow: 0 0 8px 3px var(--light-gold);
  opacity: 0;
  pointer-events: none;
  z-index: 4;
  animation: floatFirefly 8s ease-in-out infinite alternate;
}
@keyframes floatFirefly {
  0% { transform: translate(0, 0); opacity: 0.1; }
  50% { opacity: 0.8; }
  100% { transform: translate(var(--fx, 50px), var(--fy, -50px)); opacity: 0.2; }
}

/* Cinematic Transition Welcome Screen */
.welcome-transition-screen {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #06030c;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.8s ease-in-out, visibility 0.8s;
}
.welcome-transition-screen.active {
  opacity: 1;
  visibility: visible;
}
.welcome-text {
  font-family: var(--font-serif);
  font-size: 3.5rem;
  color: var(--light-gold);
  text-shadow: 0 0 25px var(--gold);
  text-align: center;
  letter-spacing: 3px;
  animation: shineWelcome 3s infinite alternate;
}
@keyframes shineWelcome {
  0% { text-shadow: 0 0 10px rgba(212, 175, 55, 0.4); opacity: 0.8; }
  100% { text-shadow: 0 0 35px rgba(212, 175, 55, 0.85), 0 0 60px rgba(224, 169, 150, 0.4); opacity: 1; }
}

/* --- Heart of the Universe Section --- */
.heart-text-reveal-container {
  min-height: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}
.heart-reveal-text {
  font-family: var(--font-serif);
  font-size: 1.4rem;
  line-height: 1.8;
  color: var(--light-gold);
  white-space: pre-line;
  text-align: center;
  transition: opacity 1s, filter 1s;
}
.heart-reveal-text.faded {
  opacity: 0.5;
  filter: blur(2px);
}
.heart-photo-reveal {
  opacity: 0;
  transform: translateY(30px) scale(0.95);
  transition: opacity 1.5s cubic-bezier(0.25, 1, 0.5, 1), transform 1.5s cubic-bezier(0.25, 1, 0.5, 1);
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  width: 100%;
  max-width: 500px;
}
.heart-photo-reveal.active {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.universe-photo-frame {
  position: relative;
  width: 280px;
  height: 280px;
  border-radius: 50%;
  border: 4px solid var(--gold);
  background: var(--glass-bg);
  box-shadow: 0 0 30px rgba(224, 169, 150, 0.4), 0 0 60px rgba(212, 175, 55, 0.2);
  overflow: visible; /* Show hover butterflies fly out */
  transition: box-shadow 0.5s ease, transform 0.5s ease;
  z-index: 5;
}
.universe-photo-frame:hover {
  transform: scale(1.05);
  box-shadow: 0 0 45px rgba(224, 169, 150, 0.7), 0 0 90px rgba(212, 175, 55, 0.5);
}
.universe-center-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
  pointer-events: none;
}
.sparkle-trail-canvas {
  position: absolute;
  top: -20px;
  left: -20px;
  width: 320px;
  height: 320px;
  pointer-events: auto; /* Tracker */
  z-index: 10;
  border-radius: 50%;
}

/* Orbit tracks and stars */
.orbiting-stars-box {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 450px;
  height: 450px;
  pointer-events: none;
  z-index: 2;
}
.orbit-track {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: 1px dashed rgba(224, 169, 150, 0.15);
}
.orbit-track.track-1 { width: 340px; height: 340px; animation: orbitRot 10s linear infinite; }
.orbit-track.track-2 { width: 400px; height: 400px; animation: orbitRot 15s linear infinite reverse; }
.orbit-track.track-3 { width: 460px; height: 460px; animation: orbitRot 20s linear infinite; }

.orbit-star {
  position: absolute;
  font-size: 1.1rem;
  filter: drop-shadow(0 0 5px var(--gold));
  animation: starPulse 1.5s ease-in-out infinite alternate;
}
.orbit-star.star-1 { top: -8px; left: 50%; transform: translateX(-50%); }
.orbit-star.star-2 { bottom: -8px; left: 50%; transform: translateX(-50%); }
.orbit-star.star-3 { top: 50%; right: -8px; transform: translateY(-50%); }

@keyframes orbitRot {
  0% { transform: translate(-50%, -50%) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(360deg); }
}
@keyframes starPulse {
  0% { transform: scale(0.8) opacity: 0.7; }
  100% { transform: scale(1.2) opacity: 1; }
}

/* Butterflies that spawn on photo hover */
.photo-hover-butterfly {
  position: absolute;
  width: 14px;
  height: 10px;
  pointer-events: none;
  z-index: 12;
  animation: photoFly 2s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}
.photo-hover-butterfly .wing {
  position: absolute;
  width: 7px;
  height: 10px;
  background: linear-gradient(to bottom, var(--light-gold), var(--gold));
  border-radius: 7px 7px 3px 3px;
  transform-origin: right center;
  animation: flapWing 0.1s linear infinite alternate;
  box-shadow: 0 0 4px var(--gold);
}
.photo-hover-butterfly .wing.right {
  left: 7px;
  transform-origin: left center;
  animation-name: flapWingRight;
}
@keyframes photoFly {
  0% { transform: translate(0, 0) scale(0) rotate(0deg); opacity: 0; }
  10% { opacity: 1; transform: translate(0, 0) scale(1) rotate(15deg); }
  100% { transform: translate(var(--dx, 60px), var(--dy, -60px)) scale(0.6) rotate(45deg); opacity: 0; }
}
.universe-sub-caption {
  font-family: var(--font-cursive);
  font-size: 2.2rem;
  color: var(--soft-pink);
  text-shadow: 0 0 10px rgba(224, 169, 150, 0.3);
}

/* --- Gallery Spotlight --- */
.gallery-spotlight-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 600px;
  width: 90%;
  padding: 25px;
  margin: 0 auto 50px auto;
  border: 2px solid var(--gold);
  box-shadow: 0 0 25px rgba(212, 175, 55, 0.35);
  transition: transform 0.4s ease, box-shadow 0.4s ease;
  position: relative;
  overflow: hidden;
}
.gallery-spotlight-card:hover {
  transform: translateY(-8px) scale(1.02);
  box-shadow: 0 0 40px rgba(212, 175, 55, 0.6);
}
.spotlight-frame-wrapper {
  position: relative;
  width: 100%;
  height: 320px;
  overflow: hidden;
  border-radius: 12px;
  border: 1px solid var(--glass-border);
}
.spotlight-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}
.gallery-spotlight-card:hover .spotlight-img {
  transform: scale(1.05);
}
.spotlight-info {
  margin-top: 20px;
  text-align: center;
}
.spotlight-title {
  font-family: var(--font-serif);
  font-size: 1.4rem;
  color: var(--light-gold);
  margin-bottom: 8px;
}
.spotlight-caption {
  font-family: var(--font-cursive);
  font-size: 1.6rem;
  color: var(--soft-pink);
}

/* Spotlight Rose Petals */
.spotlight-rose-petals-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 5;
  overflow: hidden;
}
.spotlight-petal {
  position: absolute;
  top: -20px;
  font-size: 1rem;
  opacity: 0;
  animation: fallPetal 4.5s linear infinite;
}
@keyframes fallPetal {
  0% { transform: translateY(0) rotate(0deg); opacity: 0; }
  10% { opacity: 0.7; }
  90% { opacity: 0.7; }
  100% { transform: translateY(340px) rotate(360deg); opacity: 0; }
}

/* --- Final Moon Transformation & Zoom --- */
.grand-ending-moon-placeholder {
  width: 180px;
  height: 180px;
  border-radius: 50%;
  border: 4px solid var(--gold);
  background: radial-gradient(circle at 30% 30%, #ffffff 0%, var(--light-gold) 60%, var(--rose-gold) 100%);
  margin: 30px auto;
  box-shadow: 0 0 35px var(--gold);
  overflow: visible; /* Show floating stars outside moon bounds */
  position: relative;
  transform: scale(0.6);
  animation: moonSlowZoom 4s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  transition: transform 0.5s ease;
}

@keyframes moonSlowZoom {
  0% { transform: scale(0.6); box-shadow: 0 0 20px var(--gold); }
  100% { transform: scale(1.1); box-shadow: 0 0 45px 10px rgba(212, 175, 55, 0.6); }
}

.moon-texture-glow {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.8) 0%, rgba(243, 229, 171, 0.3) 50%, transparent 100%);
  opacity: 1;
  transition: opacity 1.5s ease;
  z-index: 2;
}

.grand-ending-moon-placeholder.transformed .moon-texture-glow {
  opacity: 0;
}

.grand-ending-moon-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
  opacity: 0;
  transition: opacity 1.5s ease;
  z-index: 1;
}

.grand-ending-moon-placeholder.transformed .grand-ending-moon-img {
  opacity: 1;
}

/* Ending Floating Stars */
.ending-floating-stars {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  pointer-events: none;
  z-index: 4;
}
.end-star {
  position: absolute;
  font-size: 1.2rem;
  filter: drop-shadow(0 0 5px var(--gold));
  animation: driftStar 4s ease-in-out infinite alternate;
}
.end-star.s1 { top: -20px; left: -20px; animation-delay: 0.5s; }
.end-star.s2 { top: -20px; right: -20px; animation-delay: 1.2s; }
.end-star.s3 { bottom: -20px; left: -20px; animation-delay: 1.8s; }
.end-star.s4 { bottom: -20px; right: -20px; animation-delay: 2.5s; }

/* ==========================================================================
   ✨ ENDING SEQUENCE & LETTER SURPRISES STYLE ✨
   ========================================================================== */

/* Glowing Gift Box Wrapper */
.ending-glowing-box-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 30px;
}

.glowing-gift-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  padding: 20px 35px;
  border-radius: 16px;
  border: 1px solid var(--glass-border);
  background: var(--glass-bg);
  box-shadow: 0 0 25px rgba(224, 169, 150, 0.2);
  transition: all 0.4s ease;
  user-select: none;
}

.glowing-gift-box:hover {
  transform: translateY(-5px);
  box-shadow: 0 0 40px rgba(224, 169, 150, 0.65), 0 0 20px rgba(212, 175, 55, 0.35);
  border-color: var(--rose-gold);
}

.glowing-gift-box .gift-emoji {
  font-size: 3.5rem;
  margin-bottom: 12px;
  animation: bounceGift 2s infinite alternate cubic-bezier(0.25, 0.8, 0.25, 1);
  filter: drop-shadow(0 0 8px rgba(212, 175, 55, 0.3));
}

.glowing-gift-box small {
  color: var(--light-gold);
  font-family: var(--font-serif);
  font-size: 1rem;
  letter-spacing: 1.5px;
  text-shadow: 0 0 6px rgba(243, 229, 171, 0.4);
}

@keyframes bounceGift {
  0% { transform: translateY(0) scale(1); }
  100% { transform: translateY(-8px) scale(1.08) rotate(3deg); }
}

/* Envelope Modal Overlay */
.letter-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(6, 3, 15, 0.94);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 15000 !important;
  overflow: hidden;
}

.letter-box-envelope {
  position: relative;
  width: 460px;
  height: 300px;
  background: radial-gradient(circle at center, #f4e5ab 20%, #d4c5a0 100%);
  border-radius: 0 0 16px 16px;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.65), inset 0 -5px 15px rgba(0,0,0,0.1);
  perspective: 1500px;
  transform-style: preserve-3d;
  transition: transform 1.5s cubic-bezier(0.25, 1, 0.5, 1);
  margin-bottom: 20px;
}

.letter-box-envelope.paper-slide {
  transform: translateY(100px);
}

.letter-envelope-flap {
  position: absolute;
  top: 0;
  left: 0;
  width: 0;
  height: 0;
  border-left: 230px solid transparent;
  border-right: 230px solid transparent;
  border-top: 160px solid #c2b28a;
  transform-origin: top center;
  transition: transform 1.5s cubic-bezier(0.25, 1, 0.5, 1), border-top-color 1.5s ease;
  z-index: 10;
  filter: drop-shadow(0 5px 6px rgba(0,0,0,0.25));
}

.letter-box-envelope.flap-open .letter-envelope-flap {
  transform: rotateX(180deg);
  z-index: 1;
  border-top-color: #d4c5a0;
  filter: drop-shadow(0 -5px 6px rgba(0,0,0,0.1));
}

.letter-paper-sheet {
  position: absolute;
  bottom: 12px;
  left: 18px;
  width: 424px;
  height: 276px;
  background: #fffdf5;
  border-radius: 8px;
  box-shadow: inset 0 0 25px rgba(0,0,0,0.06), 0 5px 20px rgba(0,0,0,0.2);
  padding: 35px 30px;
  box-sizing: border-box;
  transition: transform 1.5s cubic-bezier(0.25, 1, 0.5, 1), height 1.5s cubic-bezier(0.25, 1, 0.5, 1), z-index 0s 0.75s;
  z-index: 2;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.letter-box-envelope.paper-slide .letter-paper-sheet {
  transform: translateY(-290px);
  height: 480px;
  z-index: 15;
  box-shadow: 0 20px 45px rgba(0,0,0,0.45);
}

.letter-paper-content {
  color: #3b2f1f;
  font-family: var(--font-cursive);
  font-size: 1.85rem;
  line-height: 1.5;
  text-align: left;
  overflow-y: auto;
  flex: 1;
  padding-right: 5px;
  word-wrap: break-word;
}

.letter-paper-content::-webkit-scrollbar {
  width: 4px;
}
.letter-paper-content::-webkit-scrollbar-thumb {
  background: #c2b28a;
  border-radius: 2px;
}

.letter-paper-date {
  font-family: var(--font-serif);
  font-size: 0.95rem;
  color: #8c765c;
  font-style: italic;
  border-top: 1px solid rgba(140, 118, 92, 0.25);
  padding-top: 15px;
  margin-top: 15px;
  text-align: center;
  font-weight: 500;
  animation: fadeInGlow 1.5s ease-out forwards;
}

.letter-close-btn {
  display: block;
  width: fit-content;
  margin: 20px auto 0 auto;
  background: linear-gradient(135deg, var(--rose-gold) 0%, var(--gold) 100%);
  color: var(--deep-purple);
  border: none;
  padding: 8px 30px;
  border-radius: 25px;
  font-weight: bold;
  font-family: var(--font-sans);
  font-size: 0.9rem;
  letter-spacing: 1px;
  cursor: pointer;
  transition: transform 0.25s, box-shadow 0.25s;
  box-shadow: 0 4px 15px rgba(224, 169, 150, 0.35);
  animation: fadeInGlow 1.5s ease-out forwards;
}

.letter-close-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(212, 175, 55, 0.65);
}

.letter-final-quote {
  margin-top: 40px;
  text-align: center;
  color: var(--light-gold);
  text-shadow: 0 0 15px rgba(243, 229, 171, 0.65), 0 0 30px rgba(212, 175, 55, 0.3);
  font-family: var(--font-serif);
  font-size: 1.35rem;
  line-height: 1.9;
  font-style: italic;
  font-weight: 300;
  letter-spacing: 0.5px;
  animation: fadeInGlow 2.5s ease-out forwards;
}

.letter-final-quote p {
  margin-bottom: 5px;
}

@keyframes fadeInGlow {
  0% { opacity: 0; transform: translateY(12px); filter: blur(3px); }
  100% { opacity: 1; transform: translateY(0); filter: blur(0); }
}

/* Thank You Final Screen Overlay */
.thank-you-screen {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: radial-gradient(circle at center, #0f0724 0%, #030208 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 25000 !important;
  opacity: 0;
  transition: opacity 2.5s ease-in-out;
  pointer-events: none;
  overflow: hidden;
}

.thank-you-screen.active {
  opacity: 1;
  pointer-events: auto;
}

.thank-you-stars {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.thank-you-star {
  position: absolute;
  width: 2.5px;
  height: 2.5px;
  background: #ffffff;
  border-radius: 50%;
  opacity: 0;
  animation: twinkleStar 3.5s ease-in-out infinite;
  box-shadow: 0 0 6px 2px rgba(255, 255, 255, 0.4);
}

@keyframes twinkleStar {
  0%, 100% { opacity: 0.15; transform: scale(0.8); }
  50% { opacity: 0.95; transform: scale(1.3); }
}

.thank-you-moon {
  position: absolute;
  top: 15%;
  right: 15%;
  width: 130px;
  height: 130px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #ffffff 0%, var(--light-gold) 60%, rgba(224, 169, 150, 0.4) 100%);
  box-shadow: 0 0 65px 20px rgba(243, 229, 171, 0.22), 0 0 100px 40px rgba(224, 169, 150, 0.12);
  opacity: 0.85;
  filter: blur(0.5px);
  animation: floatMoon 8s ease-in-out infinite;
  z-index: 2;
}

.thank-you-petals {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
  overflow: hidden;
}

.thank-you-message {
  font-family: var(--font-cursive);
  font-size: 3.8rem;
  text-align: center;
  color: #ffffff;
  text-shadow: 0 0 25px rgba(255, 255, 255, 0.55), 0 0 45px var(--rose-gold), 0 0 75px var(--gold);
  margin-bottom: 25px;
  z-index: 5;
  max-width: 90%;
  line-height: 1.35;
  animation: fadeInText 3.5s ease-out forwards;
}

.thank-you-subtext {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  text-align: center;
  color: var(--light-gold);
  text-shadow: 0 0 12px rgba(243, 229, 171, 0.6), 0 0 25px rgba(212, 175, 55, 0.2);
  line-height: 1.9;
  z-index: 5;
  max-width: 80%;
  animation: fadeInText 5s ease-out forwards;
  font-style: italic;
  font-weight: 300;
}

@keyframes fadeInText {
  0% { opacity: 0; transform: translateY(20px); filter: blur(3px); }
  100% { opacity: 1; transform: translateY(0); filter: blur(0); }
}

/* Mobile Responsiveness for letter modal and thank-you screen */
@media (max-width: 480px) {
  .letter-box-envelope {
    width: 90%;
    height: 220px;
  }
  .letter-envelope-flap {
    border-left-width: 45vw;
    border-right-width: 45vw;
    border-top-width: 110px;
  }
  .letter-paper-sheet {
    width: calc(100% - 32px);
    left: 16px;
    height: 190px;
    padding: 20px 15px;
  }
  .letter-box-envelope.paper-slide .letter-paper-sheet {
    transform: translateY(-210px);
    height: 360px;
  }
  .letter-paper-content {
    font-size: 1.3rem;
  }
  .letter-final-quote {
    font-size: 1.05rem;
    width: 90%;
    margin-top: 25px;
    line-height: 1.7;
  }
  .thank-you-message {
    font-size: 2.2rem;
    margin-bottom: 20px;
  }
  .thank-you-subtext {
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .thank-you-moon {
    width: 90px;
    height: 90px;
    top: 10%;
    right: 10%;
  }
}

@keyframes driftStar {
  0% { transform: translateY(0) scale(0.8) rotate(0deg); opacity: 0.6; }
  100% { transform: translateY(-15px) scale(1.2) rotate(45deg); opacity: 1; }
}

/* --- Redesigned 20 Birthday Moon Garden --- */
.garden-container-20 {
  position: relative;
  width: 100%;
  max-width: 600px;
  height: 480px;
  margin: 0 auto;
  border-radius: 24px;
  background: radial-gradient(circle at center, rgba(30, 15, 55, 0.45) 0%, rgba(10, 5, 20, 0.85) 100%);
  border: 1px solid var(--glass-border);
  box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.65), 0 10px 30px rgba(0, 0, 0, 0.45);
  overflow: visible;
}

@media (max-width: 600px) {
  .garden-container-20 {
    height: 380px;
    max-width: 95%;
  }
}

.garden-completion-card {
  margin-top: 35px;
  padding: 30px 40px;
  text-align: center;
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  border: 1px solid var(--glass-border);
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 25px rgba(224, 169, 150, 0.3);
  max-width: 600px;
  width: 90%;
  animation: fadeInGlow 1.5s ease-out forwards;
}

.garden-completion-card .completion-title {
  font-family: var(--font-serif);
  font-size: 2.2rem;
  color: var(--gold);
  text-shadow: 0 0 15px rgba(212, 175, 55, 0.6);
  margin-bottom: 15px;
}

.garden-completion-card .completion-subtitle {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  color: var(--light-gold);
  line-height: 1.6;
  font-style: italic;
  text-shadow: 0 0 8px rgba(243, 229, 171, 0.4);
}

.extra-ending-scene {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: #030208;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 30000 !important;
  opacity: 0;
  animation: extraEndingAnim 3s ease-in-out forwards;
}

.extra-ending-content {
  text-align: center;
  z-index: 10;
}

.extra-ending-content .extra-ending-moon {
  font-size: 3rem;
  margin: 15px 0;
  filter: drop-shadow(0 0 10px rgba(243, 229, 171, 0.6));
  animation: floatMoon 4s ease-in-out infinite;
}

.extra-ending-text {
  font-family: var(--font-serif);
  font-size: 2.8rem;
  color: var(--light-gold);
  text-shadow: 0 0 20px rgba(243, 229, 171, 0.8), 0 0 40px rgba(212, 175, 55, 0.4);
  letter-spacing: 2px;
  line-height: 1.4;
  margin: 10px 0;
  text-align: center;
}

/* Floating stars in the extra scene */
.extra-ending-stars {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.extra-ending-star {
  position: absolute;
  font-size: 1rem;
  filter: drop-shadow(0 0 5px var(--gold));
  animation: driftStar 4s ease-in-out infinite alternate;
}

@keyframes extraEndingAnim {
  0% { opacity: 0; }
  25%, 75% { opacity: 1; }
  100% { opacity: 0; }
}

/* --- Cinematic Showcase Gallery --- */
.gallery-showcase-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 600px;
  margin: 0 auto 50px auto;
  position: relative;
}

.showcase-frame-wrapper {
  position: relative;
  width: 100%;
  height: 650px;
  border-radius: 20px;
  border: 2px solid var(--gold);
  background: var(--glass-bg);
  box-shadow: 0 0 30px rgba(212, 175, 55, 0.25), inset 0 0 15px rgba(255, 255, 255, 0.05);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.5s ease;
  z-index: 2;
}

.showcase-frame-wrapper:hover {
  transform: translateY(-5px) scale(1.01);
  box-shadow: 0 0 45px rgba(212, 175, 55, 0.45), 0 0 20px rgba(224, 169, 150, 0.2);
}

.image-counter {
  position: absolute;
  top: 20px;
  right: 20px;
  background: rgba(10, 5, 20, 0.75);
  border: 1px solid rgba(224, 169, 150, 0.4);
  padding: 6px 14px;
  border-radius: 20px;
  font-family: var(--font-serif);
  color: var(--rose-gold);
  font-size: 0.9rem;
  z-index: 10;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
  letter-spacing: 1px;
}

.viewport-inner {
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 18px;
  position: relative;
  background: radial-gradient(circle at center, rgba(243, 229, 171, 0.15) 0%, rgba(10, 5, 20, 0.95) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.showcase-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  background: rgba(0, 0, 0, 0.15);
  padding: 10px;
  display: block;
  opacity: 0;
  transform: scale(0.95) translate(var(--px, 0px), var(--py, 0px));
  transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1), transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

.showcase-img.fade-in {
  opacity: 1;
  transform: scale(1) translate(var(--px, 0px), var(--py, 0px));
}

.showcase-img.fade-out {
  opacity: 0;
  transform: scale(1.05) translate(0px, 0px);
}

.nav-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(10, 5, 20, 0.6);
  border: 1px solid rgba(224, 169, 150, 0.4);
  color: var(--rose-gold);
  font-size: 1.5rem;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: all 0.3s ease;
  box-shadow: 0 0 15px rgba(224, 169, 150, 0.25);
  user-select: none;
}

.nav-arrow:hover {
  background: var(--rose-gold);
  color: var(--deep-purple);
  border-color: var(--rose-gold);
  box-shadow: 0 0 25px var(--rose-gold);
}

.nav-arrow.left {
  left: 20px;
}

.nav-arrow.right {
  right: 20px;
}

.indicator-dots {
  display: flex;
  gap: 10px;
  margin: 20px 0;
  z-index: 5;
}

.indicator-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(212, 175, 55, 0.2);
  border: 1px solid rgba(212, 175, 55, 0.4);
  cursor: pointer;
  transition: all 0.3s ease;
}

.indicator-dot.active {
  background: var(--gold);
  box-shadow: 0 0 10px var(--gold);
  transform: scale(1.2);
}

.showcase-petal {
  position: absolute;
  top: -20px;
  font-size: 1rem;
  opacity: 0;
  animation: fallShowcasePetal 6s linear infinite;
  z-index: 5;
  pointer-events: none;
}

@keyframes fallShowcasePetal {
  0% { transform: translateY(0) rotate(0deg); opacity: 0; }
  10% { opacity: 0.7; }
  90% { opacity: 0.7; }
  100% { transform: translateY(680px) rotate(360deg); opacity: 0; }
}

.standalone-polaroid-container {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  margin-top: 30px;
}

.polaroid-card.standalone-card {
  --rot: 3deg;
  cursor: pointer;
  transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
}

.polaroid-card.standalone-card:hover {
  transform: scale(1.06) rotate(-1deg) translateY(-5px) !important;
  box-shadow: 0 15px 35px rgba(224, 169, 150, 0.5), 0 0 20px rgba(212, 175, 55, 0.25) !important;
}

@media (max-width: 600px) {
  .showcase-frame-wrapper {
    aspect-ratio: auto;
    height: 450px;
    margin-bottom: 50px;
  }
  .nav-arrow {
    top: auto;
    bottom: -60px;
    transform: none;
  }
  .nav-arrow.left {
    left: calc(50% - 60px);
  }
  .nav-arrow.right {
    right: calc(50% - 60px);
  }
  .indicator-dots {
    margin-top: 75px;
  }
}

@media (max-width: 768px) and (min-width: 601px) {
  .showcase-frame-wrapper {
    height: 550px;
  }
}

/* ==========================================================================
   FINAL BUTTERFLY RELEASE CINEMATIC SCENE
   ========================================================================== */

.butterfly-release-screen {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: radial-gradient(circle at center, #080314 0%, #010103 100%);
  z-index: 24000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0;
  animation: fadeInOverlay 2s ease-in-out forwards;
  overflow: hidden;
  font-family: var(--font-serif);
  color: #fff;
  transition: background 3s ease-in-out;
}

.butterfly-release-screen.stage-quote,
.butterfly-release-screen.stage-subtitle,
.butterfly-release-screen.stage-finalLine {
  background: radial-gradient(circle at center, #03010a 0%, #000001 100%);
}

.release-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.moonlight-rays-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
  background: radial-gradient(circle at 50% 20%, rgba(243, 229, 171, 0.06) 0%, rgba(0,0,0,0) 70%);
  transition: background 3s ease-in-out;
}

.butterfly-release-screen.stage-quote .moonlight-rays-overlay,
.butterfly-release-screen.stage-subtitle .moonlight-rays-overlay,
.butterfly-release-screen.stage-finalLine .moonlight-rays-overlay {
  background: radial-gradient(circle at 50% 20%, rgba(243, 229, 171, 0.16) 0%, rgba(0,0,0,0) 60%);
}

.release-title-card {
  font-size: 2.2rem;
  font-family: var(--font-serif);
  color: var(--light-gold);
  text-shadow: 0 0 15px rgba(212, 175, 55, 0.45);
  z-index: 10;
  text-align: center;
  animation: fadeInOut 3s ease-in-out forwards;
  letter-spacing: 2px;
}

.release-quote-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  z-index: 10;
  padding: 20px;
}

.quote-line {
  font-family: var(--font-serif);
  font-size: 2.6rem;
  background: linear-gradient(135deg, #f3e5ab 0%, #ffffff 50%, #d4af37 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 0 12px rgba(243, 229, 171, 0.3));
  margin: 12px 0;
  opacity: 0;
  animation: floatAndFadeIn 1.5s ease-out forwards, textGlowPulse 4s ease-in-out infinite alternate;
}

.quote-line.line-1 {
  animation-delay: 0.5s;
}

.quote-line.line-2 {
  animation-delay: 1.8s;
}

.quote-line.line-3 {
  animation-delay: 0.5s;
  font-size: 2.3rem;
}

.quote-line.line-4 {
  animation-delay: 1.8s;
  font-size: 2.3rem;
}

.quote-subtitle {
  font-family: var(--font-cursive);
  font-size: 2.2rem;
  color: #ffb7b2; /* soft rose-gold */
  text-shadow: 0 0 10px rgba(255, 183, 178, 0.45);
  margin-top: 35px;
  opacity: 0;
  animation: floatAndFadeIn 2.2s ease-out forwards;
}

@keyframes fadeInOverlay {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeInOut {
  0% { opacity: 0; transform: scale(0.95); }
  15% { opacity: 1; transform: scale(1); }
  85% { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: scale(1.05); }
}

@keyframes floatAndFadeIn {
  0% {
    opacity: 0;
    transform: translateY(20px) scale(0.97);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes textGlowPulse {
  0% {
    filter: drop-shadow(0 0 10px rgba(243, 229, 171, 0.25));
  }
  100% {
    filter: drop-shadow(0 0 18px rgba(243, 229, 171, 0.45));
  }
}

/* Custom premium ending buttons */
.ending-trigger-btn {
  display: block;
  margin: 30px auto;
  background: linear-gradient(135deg, #ffb7b2 0%, #d4af37 100%);
  color: #0f0724;
  border: none;
  padding: 15px 40px;
  border-radius: 30px;
  font-weight: bold;
  font-family: var(--font-serif);
  font-size: 1.2rem;
  letter-spacing: 1.5px;
  cursor: pointer;
  box-shadow: 0 0 25px rgba(212, 175, 55, 0.4), inset 0 0 10px rgba(255, 255, 255, 0.3);
  transition: all 0.4s ease;
  animation: pulseEndingBtn 2s infinite alternate;
}

.ending-trigger-btn:hover {
  transform: translateY(-3px) scale(1.05);
  box-shadow: 0 0 35px rgba(212, 175, 55, 0.7), 0 0 15px rgba(255, 183, 178, 0.5);
}

.return-universe-btn {
  margin-top: 30px;
  background: linear-gradient(135deg, var(--rose-gold) 0%, var(--gold) 100%);
  color: var(--deep-purple);
  border: none;
  padding: 12px 35px;
  border-radius: 25px;
  font-weight: bold;
  font-family: var(--font-serif);
  font-size: 1.1rem;
  letter-spacing: 1px;
  cursor: pointer;
  box-shadow: 0 4px 15px rgba(224, 169, 150, 0.4);
  transition: transform 0.25s, box-shadow 0.25s;
  z-index: 100;
  animation: floatAndFadeIn 1.5s ease-out forwards;
}

.return-universe-btn:hover {
  transform: translateY(-2px) scale(1.03);
  box-shadow: 0 6px 20px rgba(212, 175, 55, 0.65);
}

.ending-completed-text {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  color: var(--light-gold);
  text-shadow: 0 0 10px rgba(212, 175, 55, 0.45);
  text-align: center;
  margin: 20px 0;
  animation: floatAndFadeIn 1.2s ease-out forwards;
}

@keyframes pulseEndingBtn {
  0% {
    box-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
  }
  100% {
    box-shadow: 0 0 35px rgba(212, 175, 55, 0.7);
  }
}

/* --- Premium Memories Section --- */
.premium-memories-board {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30px;
  width: 100%;
  max-width: 1300px;
  margin: 50px auto 30px auto;
  padding: 30px;
  background: radial-gradient(circle at center, rgba(30, 15, 55, 0.5) 0%, rgba(10, 5, 20, 0.75) 100%);
  border: 1px solid rgba(224, 169, 150, 0.25);
  border-radius: 24px;
  box-shadow: inset 0 0 50px rgba(0, 0, 0, 0.8), 0 10px 40px rgba(0, 0, 0, 0.6);
  position: relative;
}

.premium-memories-board::before {
  content: "";
  position: absolute;
  top: 15px;
  left: 15px;
  right: 15px;
  bottom: 15px;
  border: 1px dashed rgba(224, 169, 150, 0.15);
  border-radius: 20px;
  pointer-events: none;
}

.memories-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 40px;
  width: 100%;
}

.premium-memory-card {
  background: #ffffff;
  padding: 12px 12px 25px 12px;
  border-radius: 8px;
  border: 2.5px solid rgba(224, 169, 150, 0.85); /* rose-gold border */
  box-shadow: 0 12px 35px rgba(0,0,0,0.45), 0 0 15px rgba(224, 169, 150, 0.2);
  width: 230px;
  transform: rotate(var(--rot, 0deg)) translateY(0px);
  transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.5s ease, border-color 0.5s ease;
  animation: floatPremiumCard 6s ease-in-out infinite alternate;
  animation-delay: var(--delay, 0s);
  cursor: pointer;
}

.premium-memory-card .polaroid-img-wrapper {
  width: 100%;
  height: 290px; /* Increased display area for full portrait visibility */
  background: #110b24; /* Elegant deep-matte background for letterbox */
  overflow: hidden;
  border-radius: 4px;
  position: relative;
  border: 1px solid rgba(224, 169, 150, 0.2);
}

.premium-memory-card .premium-memory-img {
  width: 100%;
  height: 100%;
  object-fit: contain; /* Full portrait visibility, no face cropping */
  object-position: center;
  transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
}

.premium-memory-card .polaroid-caption {
  font-family: var(--font-cursive);
  font-size: 1.35rem;
  color: #2b1d1d;
  margin-top: 15px;
  text-align: center;
  font-weight: 600;
}

/* Hover effects */
.premium-memory-card:hover {
  transform: rotate(0deg) scale(1.08) translateY(-12px) !important;
  box-shadow: 0 20px 45px rgba(224, 169, 150, 0.9), 0 0 30px rgba(212, 175, 55, 0.5) !important;
  border-color: var(--rose-gold);
  z-index: 100;
}

.premium-memory-card:hover .premium-memory-img {
  transform: scale(1.04); /* subtle zoom within frame, safe since object-fit is contain */
}

/* Float animation */
@keyframes floatPremiumCard {
  0% {
    transform: rotate(var(--rot, 0deg)) translateY(0px);
  }
  100% {
    transform: rotate(calc(var(--rot, 0deg) + 0.8deg)) translateY(-8px);
  }
}

/* Responsive layout adjustments */
@media (max-width: 900px) {
  .memories-row {
    gap: 30px;
  }
}

@media (max-width: 767px) {
  .premium-memories-board {
    padding: 15px;
    gap: 20px;
  }
  .memories-row {
    flex-direction: column;
    align-items: center;
    gap: 25px;
  }
  .premium-memory-card {
    width: 250px;
    margin: 5px 0;
  }
  .premium-memory-card .polaroid-img-wrapper {
    height: 310px;
  }
}

/* ==========================================================================
   ✨ MEMORY BOOK IMAGE FIT & SCRAPBOOK FRAME SHOWCASE ✨
   ========================================================================== */

/* Memory Book Image Panel Luxury Showcase (All Pages) */
.book-half.right-half-showcase {
  background: radial-gradient(circle at center, #181135 0%, #0d081f 100%) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  position: relative !important;
  padding: 25px !important;
  overflow: hidden !important;
}

.book-half.right-half-showcase .moonlight-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  height: 80%;
  background: radial-gradient(circle, rgba(224, 169, 150, 0.2) 0%, rgba(224, 169, 150, 0.08) 50%, transparent 80%);
  pointer-events: none;
  filter: blur(25px);
  z-index: 1;
}

.book-half.right-half-showcase .scrapbook-frame {
  position: relative;
  z-index: 2;
  border: 1px solid rgba(224, 169, 150, 0.45); /* Subtle rose-gold border */
  padding: 12px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.02);
  box-shadow: 
    0 15px 35px rgba(0, 0, 0, 0.6), /* Soft shadow depth */
    inset 0 0 15px rgba(255, 255, 255, 0.05),
    0 0 20px rgba(224, 169, 150, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 90%;
  max-height: 90%;
  width: auto;
  height: auto;
}

.book-half.right-half-showcase .inner-mat {
  background: rgba(0, 0, 0, 0.2);
  padding: 6px;
  border-radius: 8px;
  border: 1px solid rgba(224, 169, 150, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.book-half.right-half-showcase .framed-photo {
  max-width: 100%;
  max-height: 380px; /* Ensure it stays fully inside the right-side container */
  object-fit: contain !important;
  object-position: center center !important;
  border-radius: 6px;
  display: block;
}

/* Mobile & Tablet responsive behavior for Memory Book */
@media (max-width: 768px) {
  .memory-book-container {
    height: auto !important;
    max-height: none !important;
  }
  
  .book-shelf {
    height: auto !important;
    min-height: 520px !important;
    flex-direction: column !important;
  }
  
  .book-half {
    flex: none !important;
    width: 100% !important;
    overflow-y: visible !important;
  }
  
  .book-half.right-half-showcase {
    padding: 20px !important;
    min-height: 300px !important;
  }
  
  .book-half.right-half-showcase .scrapbook-frame {
    max-width: 95% !important;
    max-height: 280px !important;
    padding: 8px !important;
  }
  
  .book-half.right-half-showcase .framed-photo {
    max-height: 240px !important;
  }
}

/* ==========================================================================
   ✨ ALWAYS & FOREVER HERO SCRAPBOOK LAYOUT ✨
   ========================================================================== */

.hero-scrapbook-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  height: 100%;
  padding: 20px 25px;
  box-sizing: border-box;
  position: relative;
  overflow-y: auto;
  overflow-x: hidden;
  text-align: center;
  background: radial-gradient(circle at center, #1b0d2a 0%, #080312 100%);
  animation: fadeIn 0.8s ease-in-out;
  border-radius: 12px;
}

/* Luxury Soft Moonlight Glow behind photo */
.hero-moonlight-glow {
  position: absolute;
  top: 30%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 70%;
  height: 50%;
  background: radial-gradient(circle, rgba(224, 169, 150, 0.28) 0%, rgba(181, 166, 201, 0.14) 50%, transparent 80%);
  pointer-events: none;
  filter: blur(35px);
  z-index: 1;
}

/* Subtle floating particles */
.hero-particles {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
}

.hero-particle {
  position: absolute;
  width: 4px;
  height: 4px;
  background: var(--light-gold);
  border-radius: 50%;
  opacity: 0.6;
  filter: drop-shadow(0 0 4px var(--gold));
  animation: floatParticle 8s infinite ease-in-out;
}

.hero-particle.hp1 { top: 15%; left: 15%; animation-delay: 0s; width: 3px; height: 3px; }
.hero-particle.hp2 { top: 40%; left: 85%; animation-delay: 2s; width: 5px; height: 5px; }
.hero-particle.hp3 { top: 70%; left: 20%; animation-delay: 4s; width: 4px; height: 4px; }
.hero-particle.hp4 { top: 25%; left: 75%; animation-delay: 1.5s; width: 4px; height: 4px; }
.hero-particle.hp5 { top: 60%; left: 80%; animation-delay: 5s; width: 3px; height: 3px; }
.hero-particle.hp6 { top: 80%; left: 65%; animation-delay: 3s; width: 5px; height: 5px; }

@keyframes floatParticle {
  0% { transform: translateY(0) translateX(0) scale(1); opacity: 0.2; }
  50% { transform: translateY(-15px) translateX(8px) scale(1.3); opacity: 0.8; }
  100% { transform: translateY(-30px) translateX(-4px) scale(1); opacity: 0.2; }
}

/* Photo Wrapper occupying 70-80% height of available area on desktop */
.hero-photo-wrapper {
  position: relative;
  z-index: 3;
  width: 100%;
  height: 290px; /* Occupies a beautiful proportion (60-70% of inner height) */
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 12px;
  box-sizing: border-box;
}

/* Photo with Rose-Gold Border & Elegant Shadow Depth */
.hero-framed-photo {
  max-height: 100%;
  max-width: 90%;
  object-fit: contain !important;
  border-radius: 8px;
  border: 3.5px solid var(--rose-gold); /* Rich rose-gold border */
  box-shadow: 
    0 15px 35px rgba(0, 0, 0, 0.7), 
    0 0 25px rgba(224, 169, 150, 0.35),
    inset 0 0 10px rgba(0,0,0,0.25);
  transition: transform 0.5s ease;
}

.hero-framed-photo:hover {
  transform: scale(1.02);
  box-shadow: 
    0 18px 40px rgba(0, 0, 0, 0.8), 
    0 0 35px rgba(224, 169, 150, 0.5);
}

/* Title styling */
.hero-book-title {
  position: relative;
  z-index: 3;
  font-family: var(--font-serif);
  color: var(--light-gold);
  font-size: 1.7rem;
  margin: 5px 0 6px 0;
  text-shadow: 0 2px 10px rgba(212, 175, 55, 0.5);
  font-weight: normal;
}

/* Text paragraph styling */
.hero-book-text {
  position: relative;
  z-index: 3;
  font-size: 0.95rem;
  line-height: 1.6;
  color: rgba(238, 238, 238, 0.9);
  max-width: 620px;
  margin: 0 0 12px 0;
  white-space: pre-line;
}

/* Nav controls */
.hero-book-nav {
  position: relative;
  z-index: 3;
  display: flex;
  gap: 15px;
  margin-top: 5px;
  margin-bottom: 5px;
}

@media (max-width: 768px) {
  .hero-scrapbook-page {
    padding: 20px 15px;
  }
  .hero-photo-wrapper {
    height: 250px;
  }
  .hero-book-title {
    font-size: 1.5rem;
  }
  .hero-book-text {
    font-size: 0.9rem;
    padding: 0 10px;
  }
}




